{
  "name": "office-ex",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:interop": "python tests/smoke_export.py && python tests/cfb_interop.py",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron apps/desktop",
    "smoke:desktop": "npm run build && node --import tsx scripts/smoke-desktop.mjs",
    "check": "npm run typecheck && npm run check:architecture && npm test",
    "audit:licenses": "node scripts/dependency-inventory.mjs",
    "setup:desktop": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "electron": "45.4.1",
    "playwright-core": "1.65.1",
    "@types/node": "24.19.2"
  }
}
